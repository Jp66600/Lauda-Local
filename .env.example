# Copie para .env e ajuste. Nada aqui e enviado para a nuvem em tempo de execucao;
# o HF_TOKEN so e usado no download inicial de modelos.

# Token do Hugging Face (opcional). Necessario apenas para baixar os modelos
# "gated" do pyannote (diarizacao, Fase 3). Crie em https://hf.co/settings/tokens
HF_TOKEN=

# Onde os pesos ficam guardados (mantem tudo dentro do projeto = portatil/offline)
VELLUM_MODELS_DIR=./models

# Binarios do ffmpeg, caso NAO estejam no PATH
# VELLUM_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# VELLUM_FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# Defaults do app (a CLI/UI sempre tem prioridade sobre isto)
VELLUM_MODEL=small
VELLUM_DEVICE=auto
VELLUM_LANGUAGE=auto

# Endpoint do Ollama para o bloco opcional de resumo local (Fase 5)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
